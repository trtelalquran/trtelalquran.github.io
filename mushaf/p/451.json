[[37,127,"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ"],[37,128,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"],[37,129,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"],[37,130,"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ"],[37,131,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"],[37,132,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"],[37,133,"وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ"],[37,134,"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ"],[37,135,"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ"],[37,136,"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ"],[37,137,"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ"],[37,138,"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ"],[37,139,"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ"],[37,140,"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ"],[37,141,"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ"],[37,142,"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ"],[37,143,"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ"],[37,144,"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ"],[37,145,"۞ فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ"],[37,146,"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ"],[37,147,"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ"],[37,148,"فَــَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ"],[37,149,"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ"],[37,150,"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ"],[37,151,"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ"],[37,152,"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ"],[37,153,"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ"]]